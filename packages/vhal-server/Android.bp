// vhal-core gRPC server for the Android Head Unit node.
//
// Domain isolation principle: every node runs its own vhal-core server.
// Android VHAL clients (rvc_service, CarService) never communicate across
// domain boundaries. They use AIDL binder to reach vhal-bridge, which reads
// from THIS local server. The Linux IC's vhal-gateway is the only
// cross-domain channel — it pushes selected properties into this server via
// gRPC SetValues.
//
// Deployment:
//   /vendor/bin/vhal-core-server          (started by vhal-core-server.rc)
//
// vhal-bridge (android.hardware.automotive.vehicle@V4-grpc-service) connects
// to this server at 127.0.0.1:50051. Deploy both binaries together.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc {
    name: "VelanProperties.json",
    vendor: true,
    src: "aidl/impl/4/default_config/config/VelanProperties.json",
    sub_dir: "automotive/vhalconfig",
}

cc_binary {
    name: "vhal-core-server",
    required: ["VelanProperties.json"],
    vendor: true,
    defaults: [
        "VehicleHalDefaults",
        "FakeVehicleHardwareDefaults",
    ],
    init_rc: ["vhal-core-server.rc"],

    srcs: [
        "aidl/impl/4/vhal/src/VehicleService.cpp",
    ],

    static_libs: [
        // gRPC server adapter: wraps FakeVehicleHardware as a VehicleServer gRPC service.
        // Provides GRPCVehicleProxyServer (server side of vhal-ipc-grpc).
        "android.hardware.automotive.vehicle@default-grpc-server-lib",

        // Simulation/property backend — holds the local property store.
        // Receives SetValues from vhal-gateway and fires change events to subscribers.
        "FakeVehicleHardware",

        // Core vehicle HAL utilities (VehiclePropertyStore, RecurrentTimer, …).
        "VehicleHalUtils",
    ],

    header_libs: [
        "IVehicleHardware",
    ],

    shared_libs: [
        "libgrpc++",
        "libprotobuf-cpp-full",
        "libjsoncpp",
        "liblog",
    ],

    cflags: [
        "-Wno-unused-parameter",
    ],
}
